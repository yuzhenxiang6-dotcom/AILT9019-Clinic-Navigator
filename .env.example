# ---------------------------------------------------------------------------
# Alibaba Cloud Bailian - Token Plan (Team Edition)
# ---------------------------------------------------------------------------
# 1. Copy this file and rename it to:  .env
# 2. Paste your group API key after the equals sign (no quotes, no spaces).
# 3. NEVER commit .env to Git. NEVER show this file during a screen recording.
#
# Key format issued by the teaching team: sk-sp-Hxxxxxxxxxxx
DASHSCOPE_API_KEY=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for the Token Plan OpenAI-compatible endpoint.
DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Model name, as listed in the official quota notice.
DASHSCOPE_MODEL=qwen3.8-flash

# Set to 1 to force offline mode even when a valid key is present.
# Useful for rehearsing the demo without spending group quota.
DASHSCOPE_FORCE_OFFLINE=0

# Request timeout in seconds. Keep it short so the demo never hangs.
DASHSCOPE_TIMEOUT=20